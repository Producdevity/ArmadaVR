find_package(Vulkan REQUIRED)
add_executable(reframed_xr_probe /project/src/xr-probe.cpp /project/src/xr-renderer.cpp)
target_compile_features(reframed_xr_probe PRIVATE cxx_std_17)
target_compile_options(reframed_xr_probe PRIVATE -Wall -Wextra -Werror -Wno-missing-field-initializers)
target_link_libraries(reframed_xr_probe PRIVATE openxr_loader Vulkan::Vulkan)
