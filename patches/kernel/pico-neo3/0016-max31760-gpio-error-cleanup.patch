Subject: misc: max31760: unwind only acquired fan GPIOs

Stop on a missing enable GPIO, preserve deferred probe and request
errors, and release only the successfully requested enable GPIO when
bypass acquisition fails. Do not turn on a partially acquired fan.

--- a/drivers/misc/max31760.c
+++ b/drivers/misc/max31760.c
@@ -168,42 +168,33 @@
 };
 
 static int max31760_parse_dt(struct device *dev,
-				struct max31760 *pdata)
+                                struct max31760 *pdata)
 {
 	struct device_node *np = dev->of_node;
 	int ret;
 
-	pdata->fan_pwr_en =
-		of_get_named_gpio(np, "qcom,fan-pwr-en", 0);
-	if (!gpio_is_valid(pdata->fan_pwr_en)) {
-		pr_err("%s fan_pwr_en gpio not specified\n", __func__);
-		ret = -EINVAL;
-	} else {
-		ret = gpio_request(pdata->fan_pwr_en, "fan_pwr_en");
-		if (ret) {
-			pr_err("max31760 fan_pwr_en gpio request failed\n");
-			goto error1;
-		}
-	}
-
-	pdata->fan_pwr_bp =
-		of_get_named_gpio(np, "qcom,fan-pwr-bp", 0);
+	pdata->fan_pwr_en = of_get_named_gpio(np, "qcom,fan-pwr-en", 0);
+	if (!gpio_is_valid(pdata->fan_pwr_en))
+		return pdata->fan_pwr_en < 0 ? pdata->fan_pwr_en : -EINVAL;
+
+	ret = gpio_request(pdata->fan_pwr_en, "fan_pwr_en");
+	if (ret)
+		return ret;
+
+	pdata->fan_pwr_bp = of_get_named_gpio(np, "qcom,fan-pwr-bp", 0);
 	if (!gpio_is_valid(pdata->fan_pwr_bp)) {
-		pr_err("%s fan_pwr_bp gpio not specified\n", __func__);
-		ret = -EINVAL;
-	} else
-		ret = gpio_request(pdata->fan_pwr_bp, "fan_pwr_bp");
-		if (ret) {
-			pr_err("max31760 fan_pwr_bp gpio request failed\n");
-			goto error2;
-	}
+		ret = pdata->fan_pwr_bp < 0 ? pdata->fan_pwr_bp : -EINVAL;
+		goto free_enable;
+	}
+
+	ret = gpio_request(pdata->fan_pwr_bp, "fan_pwr_bp");
+	if (ret)
+		goto free_enable;
+
 	turn_gpio(pdata, true);
-
-	return ret;
-
-error2:
-	gpio_free(pdata->fan_pwr_bp);
-error1:
+	return 0;
+
+free_enable:
 	gpio_free(pdata->fan_pwr_en);
 	return ret;
 }
@@ -276,7 +267,7 @@
 	ret = max31760_parse_dt(&client->dev, pdata);
 	if (ret) {
 		pr_err("%s failed to parse device tree\n", __func__);
-		return -EINVAL;
+		return ret;
 	}
 
 	ret = max31760_fan_pwr_enable_vregs(&client->dev, pdata);
