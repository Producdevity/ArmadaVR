 /*-------------------------------------------------------------------------*/
 
+static void spidev_controller_release(struct spidev_data *spidev)
+{
+	free_irq(spidev->data_irq, spidev);
+	gpio_free(spidev->rfic_io3_gpio);
+	gpio_free(spidev->rfic_io2_gpio);
+	gpio_free(spidev->data_gpio);
+}
+
+static int spidev_controller_setup(struct spidev_data *spidev)
+{
+	struct device_node *np = spidev->spi->dev.of_node;
+	int status;
+
+	spidev->data_gpio = of_get_named_gpio(np, "gpio", 0);
+	if (spidev->data_gpio < 0)
+		return spidev->data_gpio;
+	spidev->rfic_io2_gpio = of_get_named_gpio(np, "rfic-io2-gpio", 0);
+	if (spidev->rfic_io2_gpio < 0)
+		return spidev->rfic_io2_gpio;
+	spidev->rfic_io3_gpio = of_get_named_gpio(np, "rfic-io3-gpio", 0);
+	if (spidev->rfic_io3_gpio < 0)
+		return spidev->rfic_io3_gpio;
+
+	status = gpio_request_one(spidev->data_gpio, GPIOF_IN, "controller-data");
+	if (status)
+		return status;
+	status = gpio_request_one(spidev->rfic_io2_gpio, GPIOF_OUT_INIT_LOW, "rfic_io2");
+	if (status)
+		goto free_data;
+	status = gpio_request_one(spidev->rfic_io3_gpio, GPIOF_OUT_INIT_LOW, "rfic_io3");
+	if (status)
+		goto free_io2;
+	status = gpio_to_irq(spidev->data_gpio);
+	if (status < 0)
+		goto free_io3;
+	spidev->data_irq = status;
+	reinit_completion(&spi_completion);
+	atomic_set(&controller_state, 0);
+	atomic_set(&dtry_miss, 0);
+	atomic_set(&spi_status, 0);
+	status = request_irq(spidev->data_irq, ultrasonic_interrupt,
+			     IRQF_TRIGGER_RISING, "controller-data", spidev);
+	if (!status)
+		return 0;
+free_io3:
+	gpio_free(spidev->rfic_io3_gpio);
+free_io2:
+	gpio_free(spidev->rfic_io2_gpio);
+free_data:
+	gpio_free(spidev->data_gpio);
+	return status;
+}
