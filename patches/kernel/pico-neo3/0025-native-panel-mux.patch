 	vxr7200_panel_off = 0;
 	/*Added by gavin.zhao for sxr2130 lcd bring up vio enable begin */
 	if (gpio_is_valid(panel->panel_vio_gpio)) {
@@ -3978,6 +3981,13 @@
 		goto error_pinctrl_deinit;
 	}
 
+	panel->native_mux = pico_panel_mux_get(panel->panel_of_node);
+	if (IS_ERR(panel->native_mux)) {
+		rc = PTR_ERR(panel->native_mux);
+		panel->native_mux = NULL;
+		goto error_gpio_release;
+	}
+
 	rc = dsi_panel_bl_register(panel);
 	if (rc) {
 		if (rc != -EPROBE_DEFER)
@@ -3989,6 +3999,8 @@
 	goto exit;
 
 error_gpio_release:
+	pico_panel_mux_put(panel->native_mux);
+	panel->native_mux = NULL;
 	(void)dsi_panel_gpio_release(panel);
 error_pinctrl_deinit:
 	(void)dsi_panel_pinctrl_deinit(panel);
@@ -4014,6 +4026,9 @@
 	if (rc)
 		DSI_ERR("[%s] failed to unregister backlight, rc=%d\n",
