Subject: drm/msm: retain regulator cleanup state across failed shutdowns

Track owned enable references and pending load/voltage cleanup per rail.
Preserve normal shutdown and failed-enable ordering, return cleanup errors,
and finish pending cleanup before acquiring another set of references.

---
--- a/techpack/display/msm/dsi/dsi_pwr.c
+++ b/techpack/display/msm/dsi/dsi_pwr.c
@@ -118,115 +118,114 @@
 	return rc;
 }
 
-/**
- * dsi_pwr_enable_vregs() - enable/disable regulators
- */
+static int dsi_pwr_cleanup_vregs(struct dsi_regulator_info *regs)
+{
+	int i, rc, first_error = 0;
+	struct dsi_vreg *vreg;
+	bool was_enabled;
+
+	for (i = regs->count - 1; i >= 0; i--) {
+		vreg = &regs->vregs[i];
+		was_enabled = vreg->enabled;
+		if (was_enabled && vreg->pre_off_sleep)
+			usleep_range(vreg->pre_off_sleep * 1000,
+				     vreg->pre_off_sleep * 1000 + 10);
+
+		if (!regs->rollback && (vreg->voltage_pending ||
+				       (vreg->enabled && vreg->off_min_voltage))) {
+			rc = vreg->off_min_voltage ?
+				regulator_set_voltage(vreg->vreg,
+					vreg->off_min_voltage, vreg->max_voltage) : 0;
+			if (!rc)
+				vreg->voltage_pending = false;
+			else {
+				vreg->voltage_pending = true;
+				if (!first_error)
+					first_error = rc;
+			}
+		}
+		if (vreg->load_pending) {
+			rc = regulator_set_load(vreg->vreg, vreg->disable_load);
+			if (rc >= 0)
+				vreg->load_pending = false;
+			else if (!first_error)
+				first_error = rc;
+		}
+		if (regs->rollback && vreg->voltage_pending) {
+			rc = regulator_set_voltage(vreg->vreg, 0,
+						   vreg->max_voltage);
+			if (!rc)
+				vreg->voltage_pending = false;
+			else if (!first_error)
+				first_error = rc;
+		}
+		if (vreg->enabled) {
+			rc = regulator_disable(vreg->vreg);
+			if (!rc)
+				vreg->enabled = false;
+			else if (!first_error)
+				first_error = rc;
+		}
+		if (was_enabled && vreg->post_off_sleep)
+			usleep_range(vreg->post_off_sleep * 1000,
+				     vreg->post_off_sleep * 1000 + 10);
+	}
+	regs->cleanup_pending = first_error != 0;
+	return first_error;
+}
