Subject: net: cnss2: stop radio startup after RF front-end GPIO errors

Propagate GPIO failures to the existing clock and regulator rollback.
Keep the successful front-end sampling sequence and delays unchanged.

---
--- a/drivers/net/wireless/cnss2/power.c
+++ b/drivers/net/wireless/cnss2/power.c
@@ -882,10 +882,20 @@
 set_wlan_en:
 
 	cnss_pr_dbg("Enter function %s:%d \n",__func__,__LINE__);
-	gpio_direction_output(plat_priv->pinctrl_info.wlan_rffemid_gpio, 0);
-	gpio_direction_input(plat_priv->pinctrl_info.wlan_rffemid_gpio);
+	if (!gpio_is_valid(plat_priv->pinctrl_info.wlan_rffemid_gpio))
+		return plat_priv->pinctrl_info.wlan_rffemid_gpio < 0 ?
+			plat_priv->pinctrl_info.wlan_rffemid_gpio : -EINVAL;
+	ret = gpio_direction_output(plat_priv->pinctrl_info.wlan_rffemid_gpio, 0);
+	if (ret)
+		return ret;
+	ret = gpio_direction_input(plat_priv->pinctrl_info.wlan_rffemid_gpio);
+	if (ret)
+		return ret;
 	msleep(10);
-	if(gpio_get_value(plat_priv->pinctrl_info.wlan_rffemid_gpio)) {
+	ret = gpio_get_value(plat_priv->pinctrl_info.wlan_rffemid_gpio);
+	if (ret < 0)
+		return ret;
+	if (ret) {
 		cnss_wlan_rffemid = 1;
 		cnss_pr_dbg("RF FEMID is : 1\n");
 	} else {
