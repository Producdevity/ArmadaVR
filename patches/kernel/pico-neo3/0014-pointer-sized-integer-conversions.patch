Subject: arm64: make vendor pointer-to-integer conversions explicit

Preserve the existing enum, firmware field and register widths while
converting pointer carriers through unsigned long first. The video
queue address is intentionally split into two 32-bit debug registers.

--- a/techpack/video/msm/vidc/hfi_iris2.c
+++ b/techpack/video/msm/vidc/hfi_iris2.c
@@ -167,7 +167,7 @@
 				(u32)device->qdss.align_device_addr, sid);
 	/* update queues vaddr for debug purpose */
 	__write_register(device, CPU_CS_VCICMDARG0_IRIS2,
-		(u32)device->iface_q_table.align_virtual_addr, sid);
+		(u32)(unsigned long)device->iface_q_table.align_virtual_addr, sid);
 	__write_register(device, CPU_CS_VCICMDARG1_IRIS2,
 		(u32)((u64)device->iface_q_table.align_virtual_addr >> 32),
 		sid);
