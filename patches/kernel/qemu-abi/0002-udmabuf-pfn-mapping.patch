From: Vivek Kasireddy <vivek.kasireddy@intel.com>
Subject: [QEMU ABI] udmabuf: use PFN mappings for exported memfd buffers

Backport upstream 7d79cd784470395539bda91bf0b3505ff5b2ab6d to the
vendor 5.10 API. Closing the source memfd while an exported DMA buffer
is mapped must not leave ordinary page mappings in the evicted shmem
inode. Map the retained pages by PFN, as upstream does.

The vendor kernel predates vm_flags_set(), so update vm_flags directly.
This patch belongs to the QEMU ABI variant, which enables CONFIG_UDMABUF.

Upstream: https://github.com/torvalds/linux/commit/7d79cd784470395539bda91bf0b3505ff5b2ab6d

--- a/drivers/dma-buf/udmabuf.c
+++ b/drivers/dma-buf/udmabuf.c
@@ -27,12 +27,13 @@ static vm_fault_t udmabuf_vm_fault(struct vm_fault *vmf)
 	struct vm_area_struct *vma = vmf->vma;
 	struct udmabuf *ubuf = vma->vm_private_data;
 	pgoff_t pgoff = vmf->pgoff;
+	unsigned long pfn;
 
 	if (pgoff >= ubuf->pagecount)
 		return VM_FAULT_SIGBUS;
-	vmf->page = ubuf->pages[pgoff];
-	get_page(vmf->page);
-	return 0;
+
+	pfn = page_to_pfn(ubuf->pages[pgoff]);
+	return vmf_insert_pfn(vma, vmf->address, pfn);
 }
 
 static const struct vm_operations_struct udmabuf_vm_ops = {
@@ -48,6 +49,7 @@ static int mmap_udmabuf(struct dma_buf *buf, struct vm_area_struct *vma)
 
 	vma->vm_ops = &udmabuf_vm_ops;
 	vma->vm_private_data = ubuf;
+	vma->vm_flags |= VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP;
 	return 0;
 }
