 /**
+ * dma_resv_add_excl_fence_preserve - Import an independent write dependency.
+ * @obj: reservation object, with its lock held
+ * @fence: imported write fence
+ *
+ * Unlike a driver's ordered submission, an imported fence does not imply
+ * completion of earlier writers or readers. Preserve both; readers remain
+ * shared so read-only exports do not wait on other readers.
+ *
+ * Returns 0 on success, or -ENOMEM without changing the reservation.
+ */
+int dma_resv_add_excl_fence_preserve(struct dma_resv *obj,
+				   struct dma_fence *fence)
+{
+	struct dma_fence *old, *merged;
+
+	dma_resv_assert_held(obj);
+	old = dma_resv_get_excl(obj);
+	merged = dma_fence_unwrap_merge(old, fence);
+	if (!merged)
+		return -ENOMEM;
+
+	write_seqcount_begin(&obj->seq);
+	RCU_INIT_POINTER(obj->fence_excl, merged);
+	write_seqcount_end(&obj->seq);
+	dma_fence_put(old);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(dma_resv_add_excl_fence_preserve);
