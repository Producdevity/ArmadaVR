+static int dma_buf_get_sync_fence(struct dma_buf *dmabuf, bool write,
+				  struct dma_fence **result)
+{
+	struct dma_fence **fences, **heads;
+	struct dma_fence_unwrap *cursors;
+	unsigned int count, i;
+	int ret;
+
+	if (!write) {
+		*result = dma_resv_get_excl_rcu(dmabuf->resv);
+		return 0;
+	}
+
+	ret = dma_resv_get_fences_rcu(dmabuf->resv, NULL, &count, &fences);
+	if (ret)
+		return ret;
+	if (!count) {
+		*result = NULL;
+		return 0;
+	}
+	if (count == 1) {
+		*result = fences[0];
+		kfree(fences);
+		return 0;
+	}
+
+	/* The unwrap helper consumes its cursor array, not our owned references. */
+	heads = kmalloc_array(count, sizeof(*heads), GFP_KERNEL);
+	cursors = kcalloc(count, sizeof(*cursors), GFP_KERNEL);
+	if (!heads || !cursors) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	memcpy(heads, fences, count * sizeof(*heads));
+	*result = __dma_fence_unwrap_merge(count, heads, cursors);
+	if (!*result)
+		ret = -ENOMEM;
+out:
+	kfree(cursors);
+	kfree(heads);
+	for (i = 0; i < count; i++)
+		dma_fence_put(fences[i]);
+	kfree(fences);
+	return ret;
+}
+
+static long dma_buf_export_sync_file(struct dma_buf *dmabuf,
+				     void __user *user_data)
+{
+	struct dma_buf_export_sync_file arg;
+	struct dma_fence *fence = NULL;
+	struct sync_file *sync_file;
+	int fd, ret;
+
+	if (copy_from_user(&arg, user_data, sizeof(arg)))
+		return -EFAULT;
+
+	if (arg.flags & ~DMA_BUF_SYNC_RW)
+		return -EINVAL;
+
+	if ((arg.flags & DMA_BUF_SYNC_RW) == 0)
+		return -EINVAL;
+
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0)
+		return fd;
+
+	ret = dma_buf_get_sync_fence(dmabuf, arg.flags & DMA_BUF_SYNC_WRITE,
+				     &fence);
+	if (ret)
+		goto err_put_fd;
+
+	if (!fence)
+		fence = dma_fence_get_stub();
+
+	sync_file = sync_file_create(fence);
+
+	dma_fence_put(fence);
+
+	if (!sync_file) {
+		ret = -ENOMEM;
+		goto err_put_fd;
+	}
+
+	arg.fd = fd;
+	if (copy_to_user(user_data, &arg, sizeof(arg))) {
+		ret = -EFAULT;
+		goto err_put_file;
+	}
+
+	fd_install(fd, sync_file->file);
+
+	return 0;
+
+err_put_file:
+	fput(sync_file->file);
+err_put_fd:
+	put_unused_fd(fd);
+	return ret;
+}
+
+static long dma_buf_import_sync_file(struct dma_buf *dmabuf,
+				     const void __user *user_data)
+{
+	struct dma_buf_import_sync_file arg;
+	struct dma_fence *fence;
+	int ret = 0;
+
+	if (copy_from_user(&arg, user_data, sizeof(arg)))
+		return -EFAULT;
+
+	if (arg.flags & ~DMA_BUF_SYNC_RW)
+		return -EINVAL;
+
+	if ((arg.flags & DMA_BUF_SYNC_RW) == 0)
+		return -EINVAL;
+
+	fence = sync_file_get_fence(arg.fd);
+	if (!fence)
+		return -EINVAL;
+
+	dma_resv_lock(dmabuf->resv, NULL);
+
+	if (arg.flags & DMA_BUF_SYNC_WRITE) {
+		ret = dma_resv_add_excl_fence_preserve(dmabuf->resv, fence);
+	} else {
+		ret = dma_resv_reserve_shared(dmabuf->resv, 1);
+		if (!ret)
+			dma_resv_add_shared_fence(dmabuf->resv, fence);
+	}
+
+	dma_resv_unlock(dmabuf->resv);
+
+	dma_fence_put(fence);
+
+	return ret;
+}
