-// Smt: [FEAT_FREEZE]
-/**
- *  bit 0, default
- *  bit 1, lite
- *  bit 2, lightning
- *  unfreeze -> freeze always allow
- *  freeze -> unfreeze need follow law as below
- *  |-------|----|----|----|
- *  |old\new| D  | L  | LN |
- *  |----------------------|
- *  |   D   | 1  | 0  | 0  |
- *  |----------------------|
- *  |   L   | 1  | 1  | 0  |
- *  |----------------------|
- *  |   LN  | 0  | 0  | 1  |
- *  |----------------------|
- *
- *  freeze -> freeze only allow lite to default
- *  unfreeze -> unfreeze nothing to do
- **/
-#define     LEN     3
-int freeze2unfreeze[LEN][LEN] = {
-	{1, 0, 0},
-	{1, 1, 0},
-	{0, 0, 1}
-};
-
-static inline int
-convert_to_freeze_mode(int index) {
-    if (index < 0 || index >= LEN) {
-        index = 0;
-    }
-	return BIT(index);
-}
-
-static inline int
-unconvert_from_freeze_mode(int mode) {
-    int n = 0;
-    if (mode == 0) {
-        return 0;
-    }
-    while (!(mode >> n & 1)) {
-        n++;
-    }
-	return n;
-}
-
-static inline int
-check_set_validity(int old_frozen, int new_frozen, int old_mode, int new_mode) {
-	bool can_set = false;
-
-	if (old_frozen && !new_frozen) { // freeze->unfreeze
-        if (old_mode < 0 || old_mode >= LEN || new_mode < 0 || new_mode >= LEN) {
-            return false;
-        }
-        can_set = freeze2unfreeze[old_mode][new_mode];
-	} else if (!old_frozen && new_frozen) {// unfreeze->freeze
-		can_set = true;
-	} else if (old_frozen && new_frozen) { // freeze -> freeze
-		can_set = (convert_to_freeze_mode(old_mode) & BINDER_FREEZE_MODE_LITE)
-			&& (convert_to_freeze_mode(new_mode) & BINDER_FREEZE_MODE_DEFAULT);
-    }
-	return can_set;
-}
