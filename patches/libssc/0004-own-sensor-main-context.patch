 	g_mutex_unlock (&ctx->mutex);
 }
 
@@ -76,4 +78,21 @@
 	g_mutex_clear (&ctx->mutex);
 	g_cond_clear (&ctx->condition);
 	g_object_unref (ctx->result);
+	g_main_context_unref (ctx->main_context);
 }
+
+GSource *
+ssc_common_timeout_source (guint seconds, GSourceFunc callback, gpointer data)
+{
+	GSource *source = g_timeout_source_new_seconds (seconds);
+	g_source_set_callback (source, callback, data, NULL);
+	g_source_attach (source, g_main_context_get_thread_default ());
+	return source;
+}
+
+void
+ssc_common_clear_source (GSource *source)
+{
+	g_source_destroy (source);
+	g_source_unref (source);
+}
