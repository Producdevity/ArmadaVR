+
+static ReportReceivedContext *
+operation_ref (ReportReceivedContext *ctx)
+{
+	g_ref_count_inc (&ctx->references);
+	return ctx;
+}
+
+static void
+operation_unref (ReportReceivedContext *ctx)
+{
+	if (g_ref_count_dec (&ctx->references)) {
+		g_clear_object (&ctx->task);
+		g_slice_free (ReportReceivedContext, ctx);
+	}
+}
+
+static void
+operation_finish (ReportReceivedContext *ctx, gboolean success, GError *error)
+{
+	if (ctx->finished) {
+		g_clear_error (&error);
+		return;
+	}
+	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (ctx->sensor);
+	ctx->finished = TRUE;
+	g_clear_signal_handler (&priv->report_id, priv->client);
+	g_clear_pointer (&priv->discovery_timeout, ssc_common_clear_source);
+	g_clear_pointer (&ctx->cancel_source, ssc_common_clear_source);
+	priv->operation = NULL;
+	if (error)
+		g_task_return_error (ctx->task, error);
+	else
+		g_task_return_boolean (ctx->task, success);
+	g_clear_object (&ctx->task);
+	operation_unref (ctx);
+}
+
+static gboolean
+operation_cancelled (GCancellable *cancellable, gpointer data)
+{
+	(void)cancellable;
+	operation_finish (data, FALSE, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED,
+	                                                  "Sensor operation cancelled"));
+	return G_SOURCE_REMOVE;
+}
+
+static ReportReceivedContext *
+operation_new (SSCSensor *self, GTask *task)
+{
+	SSCSensorPrivate *priv = ssc_sensor_get_instance_private (self);
+	ReportReceivedContext *ctx = g_slice_new0 (ReportReceivedContext);
+	g_assert_null (priv->operation);
+	g_ref_count_init (&ctx->references);
+	ctx->task = task;
+	ctx->sensor = self;
+	priv->operation = ctx;
+	priv->report_id = g_signal_connect (priv->client, "report", G_CALLBACK (report_received), ctx);
+	priv->discovery_timeout = ssc_common_timeout_source (SENSOR_SERVICE_TIMEOUT_S,
+	                                                   sensor_service_discovery_timeout, ctx);
+	GCancellable *cancellable = g_task_get_cancellable (task);
+	if (cancellable) {
+		ctx->cancel_source = g_cancellable_source_new (cancellable);
+		g_source_set_callback (ctx->cancel_source, G_SOURCE_FUNC (operation_cancelled), ctx, NULL);
+		g_source_attach (ctx->cancel_source, g_task_get_context (task));
+	}
+	return ctx;
+}
+
+static void
+operation_request_ready (SSCClient *client, GAsyncResult *result, gpointer data)
+{
+	ReportReceivedContext *ctx = data;
+	GError *error = NULL;
+	if (!ssc_client_send_finish (client, result, &error)) {
+		if (!ctx->finished)
+			operation_finish (ctx, FALSE, g_steal_pointer (&error));
+		g_clear_error (&error);
+	}
+	operation_unref (ctx);
 }
 
