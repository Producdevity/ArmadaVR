Subject: sensor: recognize Pico controller measurements during startup

The ble_mcu stream reports data with message ID 1024. Accept that ID only for
this data type when a measurement completes the pending enable request.

--- a/src/libssc-sensor.c
+++ b/src/libssc-sensor.c
@@ -490,7 +490,8 @@
 	 * Apply this for any sensor to cover new sensors in the future as well.
 	 * Either a configuration update or measurement will complete the task and disconnect the listener.
 	 */
-	} else if (uid_high == priv->uid_high && uid_low == priv->uid_low && (msg_id == SSC_MSG_REPORT_MEASUREMENT || msg_id == SSC_MSG_REPORT_MEASUREMENT_PROXIMITY)) {
+	} else if (uid_high == priv->uid_high && uid_low == priv->uid_low && (msg_id == SSC_MSG_REPORT_MEASUREMENT || msg_id == SSC_MSG_REPORT_MEASUREMENT_PROXIMITY ||
+		   (msg_id == 1024 && g_strcmp0 (priv->data_type, "ble_mcu") == 0))) {
 		g_debug ("Measurement received for '%s' sensor (%" G_GUINT64_FORMAT " %" G_GUINT64_FORMAT "), assuming enabled", priv->data_type, priv->uid_high, priv->uid_low);
 
 		if (ctx->task) {
