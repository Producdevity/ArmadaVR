+TEST_CASE("u_pacing_compositor_fake_vblank_phase")
+{
+	for (int64_t hz : {72, 90, 120}) {
+		int64_t period = INT64_C(1000000000) / hz;
+		u_pacing_compositor *upc = nullptr;
+		REQUIRE(u_pc_fake_create(period, 0, &upc) == XRT_SUCCESS);
+		REQUIRE(upc != nullptr);
+		int64_t vblank = INT64_C(10000000000) + period / 4;
+		for (int i = 0; i < 64; i++) {
+			vblank += period + period / 3;
+			u_pc_update_vblank_from_display_control(upc, vblank);
+			int64_t now = vblank + 1000;
+			CompositorPredictions prediction;
+			u_pc_predict(upc, now, &prediction.frame_id, &prediction.wake_up_time_ns,
+			             &prediction.desired_present_time_ns, &prediction.present_slop_ns,
+			             &prediction.predicted_display_time_ns, &prediction.predicted_display_period_ns,
+			             &prediction.min_display_period_ns);
+			CHECK(prediction.wake_up_time_ns >= now);
+			CHECK(prediction.desired_present_time_ns > now);
+			CHECK((prediction.desired_present_time_ns - vblank) % period == 0);
+			CHECK(prediction.predicted_display_period_ns == period);
+			CHECK(prediction.min_display_period_ns == period);
+		}
+		u_pc_destroy(&upc);
+		CHECK(upc == nullptr);
+	}
+}
