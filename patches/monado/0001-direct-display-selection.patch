+static VkResult
+choose_display_plane(struct comp_target_swapchain *cts,
+                     VkDisplayKHR display,
+                     VkDisplayModeKHR mode,
+                     VkExtent2D extent,
+                     uint32_t *out_plane,
+                     uint32_t *out_stack,
+                     VkDisplayPlaneAlphaFlagBitsKHR *out_alpha)
+{
+	struct vk_bundle *vk = get_vk(cts);
+	VkDisplayPropertiesKHR *displays = NULL;
+	uint32_t display_count = 0;
+	VkResult ret = vk_enumerate_physical_device_display_properties(
+	    vk, vk->physical_device, &display_count, &displays);
+	if (ret != VK_SUCCESS) {
+		return ret;
+	}
+	bool identity_supported = false;
+	for (uint32_t i = 0; i < display_count; i++) {
+		if (displays[i].display == display) {
+			identity_supported = (displays[i].supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR) != 0;
+			break;
+		}
+	}
+	free(displays);
+	if (!identity_supported) {
+		COMP_ERROR(cts->base.c, "Selected display does not support identity scanout");
+		return VK_ERROR_INITIALIZATION_FAILED;
+	}
+
+	VkDisplayPlanePropertiesKHR *planes = NULL;
+	uint32_t plane_count = 0;
+	ret = vk_enumerate_physical_display_plane_properties(vk, vk->physical_device, &plane_count, &planes);
+	if (ret != VK_SUCCESS) {
+		return ret;
+	}
+	ret = VK_ERROR_INITIALIZATION_FAILED;
+	for (uint32_t i = 0; i < plane_count; i++) {
+		if (planes[i].currentDisplay != VK_NULL_HANDLE && planes[i].currentDisplay != display) {
+			continue;
+		}
+		VkDisplayKHR *supported = NULL;
+		uint32_t count = 0;
+		ret = vk_enumerate_display_plane_supported_displays(vk, vk->physical_device, i, &count, &supported);
+		if (ret != VK_SUCCESS) {
+			break;
+		}
+		bool compatible = false;
+		for (uint32_t j = 0; j < count; j++) {
+			compatible |= supported[j] == display;
+		}
+		free(supported);
+		ret = VK_ERROR_INITIALIZATION_FAILED;
+		if (!compatible) {
+			continue;
+		}
+
+		VkDisplayPlaneCapabilitiesKHR caps;
+		ret = vk->vkGetDisplayPlaneCapabilitiesKHR(vk->physical_device, mode, i, &caps);
+		if (ret != VK_SUCCESS) {
+			break;
+		}
+		VkDisplayPlaneAlphaFlagBitsKHR alpha = choose_alpha_mode(caps.supportedAlpha);
+		ret = VK_ERROR_INITIALIZATION_FAILED;
+		if (!alpha || caps.minSrcPosition.x > 0 || caps.maxSrcPosition.x < 0 ||
+		    caps.minSrcPosition.y > 0 || caps.maxSrcPosition.y < 0 ||
+		    caps.minDstPosition.x > 0 || caps.maxDstPosition.x < 0 ||
+		    caps.minDstPosition.y > 0 || caps.maxDstPosition.y < 0 ||
+		    extent.width < caps.minSrcExtent.width || extent.width > caps.maxSrcExtent.width ||
+		    extent.height < caps.minSrcExtent.height || extent.height > caps.maxSrcExtent.height ||
+		    extent.width < caps.minDstExtent.width || extent.width > caps.maxDstExtent.width ||
+		    extent.height < caps.minDstExtent.height || extent.height > caps.maxDstExtent.height) {
+			continue;
+		}
+		*out_plane = i;
+		*out_stack = planes[i].currentStackIndex;
+		*out_alpha = alpha;
+		ret = VK_SUCCESS;
+		break;
+	}
+	free(planes);
+	if (ret != VK_SUCCESS) {
+		COMP_ERROR(cts->base.c, "Unable to select a compatible display plane: %s", vk_result_string(ret));
+	}
+	return ret;
+}
 
