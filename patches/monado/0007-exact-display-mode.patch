+
+static bool
+parse_display_mode(const char *text, VkDisplayModeParametersKHR *out)
+{
+	uint32_t values[3] = {0};
+	const char delimiters[3] = {'x', '@', '\0'};
+	for (unsigned i = 0; i < 3; i++) {
+		unsigned digits = 0;
+		while (*text >= '0' && *text <= '9') {
+			uint32_t digit = (uint32_t)(*text++ - '0');
+			if (++digits > 10 || values[i] > (UINT32_MAX - digit) / 10) {
+				return false;
+			}
+			values[i] = values[i] * 10 + digit;
+		}
+		if (digits == 0 || values[i] == 0 || *text != delimiters[i]) {
+			return false;
+		}
+		if (i < 2) {
+			text++;
+		}
+	}
+	*out = (VkDisplayModeParametersKHR){{values[0], values[1]}, values[2]};
+	return true;
+}
+
+static int
+choose_exact_vk_mode(const VkDisplayModePropertiesKHR *properties,
+                     uint32_t count,
+                     const VkDisplayModeParametersKHR *wanted)
+{
+	int selected = -1;
+	for (uint32_t i = 0; i < count; i++) {
+		const VkDisplayModeParametersKHR *p = &properties[i].parameters;
+		if (p->visibleRegion.width == wanted->visibleRegion.width &&
+		    p->visibleRegion.height == wanted->visibleRegion.height && p->refreshRate == wanted->refreshRate) {
+			if (selected >= 0 || i > INT_MAX) {
+				return -1;
+			}
+			selected = (int)i;
+		}
+	}
+	return selected;
 }
 
