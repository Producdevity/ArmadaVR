+#ifdef HAVE_LIBDRM
+static VkResult
+kgsl_queue_submit_drm(struct tu_queue *queue, void *submit,
+                      struct vk_sync_wait *waits, uint32_t wait_count,
+                      struct vk_sync_signal *signals, uint32_t signal_count,
+                      struct tu_u_trace_submission_data *trace)
+{
+   struct tu_device *device = queue->device;
+   struct vk_device *vk = &device->vk;
+   const int drm_fd = device->physical_device->kgsl_sync_fd;
+   struct vk_kgsl_syncobj *objects = (struct vk_kgsl_syncobj *)
+      calloc(wait_count, sizeof(*objects));
+   struct vk_sync_wait *native_waits = (struct vk_sync_wait *)
+      calloc(wait_count, sizeof(*native_waits));
+   struct vk_kgsl_syncobj completion;
+   struct vk_sync_signal native_signal = { .sync = &completion.vk, .signal_value = 0 };
+   uint32_t initialized = 0;
+   int completion_fd = -1;
+   bool completion_initialized = false;
+   VkResult result = VK_ERROR_OUT_OF_HOST_MEMORY;
+   if (wait_count && (!objects || !native_waits))
+      goto finish;
+
+   for (uint32_t i = 0; i < signal_count; ++i) {
+      if (!vk_sync_as_drm_syncobj(signals[i].sync)) {
+         result = VK_ERROR_UNKNOWN;
+         goto finish;
+      }
+   }
+   for (uint32_t i = 0; i < wait_count; ++i) {
+      struct vk_drm_syncobj *sobj = vk_sync_as_drm_syncobj(waits[i].sync);
+      if (!sobj) {
+         result = VK_ERROR_UNKNOWN;
+         goto finish;
+      }
+      result = vk_sync_init(vk, &objects[i].vk, &vk_kgsl_sync_type,
+                            (enum vk_sync_flags)0, 0);
+      if (result != VK_SUCCESS)
+         goto finish;
+      initialized++;
+      int fd;
+      if (tu_kgsl_drm_export_wait(drm_fd, sobj->syncobj, waits[i].wait_value, &fd)) {
+         result = VK_ERROR_UNKNOWN;
+         goto finish;
+      }
+      result = kgsl_syncobj_import(&objects[i].syncobj, fd);
+      if (result != VK_SUCCESS) {
+         close(fd);
+         goto finish;
+      }
+      native_waits[i] = { .sync = &objects[i].vk, .stage_mask = waits[i].stage_mask,
+                          .wait_value = 0 };
+   }
+   if (signal_count) {
+      result = vk_sync_init(vk, &completion.vk, &vk_kgsl_sync_type,
+                            (enum vk_sync_flags)0, 0);
+      if (result != VK_SUCCESS)
+         goto finish;
+      completion_initialized = true;
+   }
+   result = kgsl_queue_submit_native(queue, submit, native_waits, wait_count,
+                                     signal_count ? &native_signal : NULL,
+                                     signal_count ? 1 : 0, trace);
+   if (result != VK_SUCCESS || !signal_count)
+      goto finish;
+
+   result = kgsl_syncobj_export(&completion.syncobj, &completion_fd);
+   if (result != VK_SUCCESS) {
+      result = vk_device_set_lost(vk, "Failed to export submitted KGSL fence");
+      goto finish;
+   }
+   for (uint32_t i = 0; i < signal_count; ++i) {
+      struct vk_drm_syncobj *sobj = vk_sync_as_drm_syncobj(signals[i].sync);
+      if (tu_kgsl_drm_import_signal(drm_fd, sobj->syncobj,
+                                    signals[i].signal_value, completion_fd)) {
+         result = vk_device_set_lost(vk, "Failed to publish submitted KGSL fence");
+         goto finish;
+      }
+   }
+
+finish:
+   if (completion_fd >= 0)
+      close(completion_fd);
+   if (completion_initialized)
+      vk_sync_finish(vk, &completion.vk);
+   for (uint32_t i = 0; i < initialized; ++i)
+      vk_sync_finish(vk, &objects[i].vk);
+   free(native_waits);
+   free(objects);
+   return result;
+}
+
+static VkResult
+kgsl_init_drm_sync(struct tu_physical_device *device)
+{
+   const char *path = os_get_option("TU_KGSL_DRM_SYNC");
+   if (!path || !path[0])
+      return VK_SUCCESS;
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return vk_errorf(device->instance, VK_ERROR_INITIALIZATION_FAILED,
+                       "Cannot open TU_KGSL_DRM_SYNC device %s", path);
+   struct util_sync_provider *provider = util_sync_provider_drm(fd);
+   if (!provider) {
+      close(fd);
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   device->syncobj_type = vk_drm_syncobj_get_type_from_provider(provider);
+   provider->finalize(provider);
+   const unsigned required = VK_SYNC_FEATURE_BINARY | VK_SYNC_FEATURE_TIMELINE |
+                             VK_SYNC_FEATURE_CPU_WAIT | VK_SYNC_FEATURE_CPU_SIGNAL |
+                             VK_SYNC_FEATURE_WAIT_PENDING;
+   if ((device->syncobj_type.features & required) != required) {
+      close(fd);
+      return vk_errorf(device->instance, VK_ERROR_INITIALIZATION_FAILED,
+                       "TU_KGSL_DRM_SYNC requires DRM timeline sync objects");
+   }
+   device->kgsl_sync_fd = fd;
+   device->has_kgsl_drm_sync = true;
+   device->sync_types[0] = &device->syncobj_type;
+   device->sync_types[1] = NULL;
+   return VK_SUCCESS;
+}
+#endif
+
+static VkResult
+kgsl_queue_submit(struct tu_queue *queue, void *submit,
+                  struct vk_sync_wait *waits, uint32_t wait_count,
+                  struct vk_sync_signal *signals, uint32_t signal_count,
+                  struct tu_u_trace_submission_data *trace)
+{
+#ifdef HAVE_LIBDRM
+   if (queue->device->physical_device->has_kgsl_drm_sync)
+      return kgsl_queue_submit_drm(queue, submit, waits, wait_count,
+                                   signals, signal_count, trace);
+#endif
+   return kgsl_queue_submit_native(queue, submit, waits, wait_count,
+                                   signals, signal_count, trace);
+}
