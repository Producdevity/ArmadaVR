+/* SPDX-License-Identifier: MIT */
+#ifndef TU_KGSL_DRM_SYNC_H
+#define TU_KGSL_DRM_SYNC_H
+
+#include <errno.h>
+#include <stdint.h>
+#include <xf86drm.h>
+
+static inline int
+tu_kgsl_drm_export_wait(int drm_fd, uint32_t handle, uint64_t point, int *fd)
+{
+   uint32_t temporary = 0;
+   *fd = -1;
+   int ret = drmSyncobjCreate(drm_fd, 0, &temporary);
+   if (ret)
+      return ret;
+   ret = drmSyncobjTransfer(drm_fd, temporary, 0, handle, point, 0);
+   if (!ret)
+      ret = drmSyncobjExportSyncFile(drm_fd, temporary, fd);
+   int saved_errno = errno;
+   drmSyncobjDestroy(drm_fd, temporary);
+   errno = saved_errno;
+   return ret;
+}
+
+static inline int
+tu_kgsl_drm_import_signal(int drm_fd, uint32_t handle, uint64_t point, int fd)
+{
+   uint32_t temporary = 0;
+   int ret = drmSyncobjCreate(drm_fd, fd == -1 ? DRM_SYNCOBJ_CREATE_SIGNALED : 0,
+                              &temporary);
+   if (ret)
+      return ret;
+   if (fd != -1)
+      ret = drmSyncobjImportSyncFile(drm_fd, temporary, fd);
+   if (!ret)
+      ret = drmSyncobjTransfer(drm_fd, handle, point, temporary, 0, 0);
+   int saved_errno = errno;
+   drmSyncobjDestroy(drm_fd, temporary);
+   errno = saved_errno;
+   return ret;
+}
+
+#endif
