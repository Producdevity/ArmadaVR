From: Reframed VR contributors
Subject: [PATCH] freedreno/kgsl: release failed and sparse BO allocations

Keep mapping ownership with the allocating caller. Unpublished BOs must not
be removed from the dump list or emit destruction events. Release rejected
address mappings, failed sparse bindings and queries, and sparse CPU mappings.

--- a/src/freedreno/vulkan/tu_knl_kgsl.cc
+++ b/src/freedreno/vulkan/tu_knl_kgsl.cc
@@ -187,6 +187,20 @@
    return result;
 }
 
+static void
+kgsl_bo_free(struct tu_device *dev, struct tu_bo *bo)
+{
+   if (bo->map)
+      munmap(bo->map, bo->size);
+
+   if (bo->shared_fd != -1)
+      close(bo->shared_fd);
+
+   struct kgsl_gpuobj_free req = { .id = bo->gem_handle };
+   memset(bo, 0, sizeof(*bo));
+   safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUOBJ_FREE, &req);
+}
+
 static VkResult
 kgsl_bo_user_map(struct tu_device *dev, struct tu_bo *bo, uint64_t client_iova)
 {
@@ -194,14 +208,12 @@
    void *map = mmap((void *)client_iova, bo->size, PROT_READ | PROT_WRITE,
                     MAP_SHARED, dev->physical_device->local_fd, offset);
    if (map == MAP_FAILED) {
-      kgsl_bo_finish(dev, bo);
-
       return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
                        "mmap failed (%s)", strerror(errno));
    }
 
    if (client_iova && (uint64_t)map != client_iova) {
-      kgsl_bo_finish(dev, bo);
+      munmap(map, bo->size);
 
       return vk_errorf(dev, VK_ERROR_INVALID_OPAQUE_CAPTURE_ADDRESS,
                        "mmap could not map the given address");
@@ -353,8 +365,11 @@
       result = kgsl_bo_user_map(dev, bo, client_iova);
    }
 
-   if (result != VK_SUCCESS)
+   if (result != VK_SUCCESS) {
+      tu_debug_bos_del(dev, bo);
+      kgsl_bo_free(dev, bo);
       return result;
+   }
 
    tu_dump_bo_init(dev, bo);
 
@@ -493,24 +508,11 @@
    tu_debug_bos_del(dev, bo);
    tu_dump_bo_del(dev, bo);
 
-   if (bo->map) {
+   if (bo->map)
       TU_RMV(bo_unmap, dev, bo);
-      munmap(bo->map, bo->size);
-   }
-
-   if (bo->shared_fd != -1)
-      close(bo->shared_fd);
 
    TU_RMV(bo_destroy, dev, bo);
-
-   struct kgsl_gpuobj_free req = {
-      .id = bo->gem_handle
-   };
-
-   /* Tell sparse array that entry is free */
-   memset(bo, 0, sizeof(*bo));
-
-   safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUOBJ_FREE, &req);
+   kgsl_bo_free(dev, bo);
 }
 
 static VkResult
@@ -557,10 +559,9 @@
       .base = base,
    };
 
+   VkResult result = VK_SUCCESS;
    if (flags & TU_SPARSE_VMA_REPLAYABLE) {
-      VkResult result = kgsl_bo_user_map(dev, bo, client_iova);
-      if (result != VK_SUCCESS)
-         return result;
+      result = kgsl_bo_user_map(dev, bo, client_iova);
    } else {
       /* GPUOBJ_ALLOC does not return the GPU address. Use its matching
        * allowlisted INFO ioctl instead of the legacy GPUMEM query. */
@@ -571,11 +572,16 @@
       ret = safe_ioctl(dev->physical_device->local_fd,
                        IOCTL_KGSL_GPUOBJ_INFO, &info);
       if (ret) {
-         return vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
-                          "GPUOBJ_INFO failed (%s)", strerror(errno));
-      }
-
-      bo->iova = info.gpuaddr;
+         result = vk_errorf(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                            "GPUOBJ_INFO failed (%s)", strerror(errno));
+      } else {
+         bo->iova = info.gpuaddr;
+      }
+   }
+
+   if (result != VK_SUCCESS) {
+      kgsl_bo_free(dev, bo);
+      return result;
    }
 
    out_vma->kgsl.virtual_bo = bo;
@@ -587,14 +593,7 @@
 kgsl_sparse_vma_finish(struct tu_device *dev,
                        struct tu_sparse_vma *vma)
 {
-   struct kgsl_gpuobj_free req = {
-      .id = vma->kgsl.virtual_bo->gem_handle
-   };
-
-   /* Tell sparse array that entry is free */
-   memset(vma->kgsl.virtual_bo, 0, sizeof(*vma->kgsl.virtual_bo));
-
-   safe_ioctl(dev->physical_device->local_fd, IOCTL_KGSL_GPUOBJ_FREE, &req);
+   kgsl_bo_free(dev, vma->kgsl.virtual_bo);
 }
 
 static VkResult
