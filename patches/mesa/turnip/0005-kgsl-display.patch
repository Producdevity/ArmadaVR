--- /dev/null
+++ b/src/freedreno/vulkan/tu_kgsl_display.h
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef TU_KGSL_DISPLAY_H
+#define TU_KGSL_DISPLAY_H
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdbool.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+
+static inline int
+tu_kgsl_display_open(const char *path, int64_t *device_major,
+                     int64_t *device_minor)
+{
+   if (!path || !path[0]) {
+      errno = EINVAL;
+      return -1;
+   }
+
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return -1;
+
+   struct stat st;
+   uint64_t prime;
+   drmModeRes *resources;
+   drmModePlaneRes *planes;
+   int saved_errno, usable;
+
+   if (fstat(fd, &st) < 0)
+      goto fail;
+   if (!S_ISCHR(st.st_mode) || drmGetNodeTypeFromFd(fd) != DRM_NODE_PRIMARY) {
+      errno = ENODEV;
+      goto fail;
+   }
+   if (drmGetCap(fd, DRM_CAP_PRIME, &prime) < 0)
+      goto fail;
+   if (!(prime & DRM_PRIME_CAP_IMPORT)) {
+      errno = ENOTSUP;
+      goto fail;
+   }
+   if (drmSetClientCap(fd, DRM_CLIENT_CAP_UNIVERSAL_PLANES, 1) < 0 ||
+       drmSetClientCap(fd, DRM_CLIENT_CAP_ATOMIC, 1) < 0)
+      goto fail;
+   if (!drmIsMaster(fd)) {
+      errno = EACCES;
+      goto fail;
+   }
+   resources = drmModeGetResources(fd);
+   if (!resources)
+      goto fail;
+   usable = resources->count_connectors > 0 && resources->count_crtcs > 0;
+   drmModeFreeResources(resources);
+   if (!usable) {
+      errno = ENODEV;
+      goto fail;
+   }
+   planes = drmModeGetPlaneResources(fd);
+   if (!planes)
+      goto fail;
+   usable = planes->count_planes > 0;
+   drmModeFreePlaneResources(planes);
+   if (!usable) {
+      errno = ENODEV;
+      goto fail;
+   }
+
+   *device_major = major(st.st_rdev);
+   *device_minor = minor(st.st_rdev);
+   return fd;
+
+fail:
+   saved_errno = errno;
+   close(fd);
+   errno = saved_errno;
+   return -1;
+}
+
+static inline bool
+tu_kgsl_display_matches_fd(int fd, int64_t device_major, int64_t device_minor)
+{
+   struct stat st;
+   return fstat(fd, &st) == 0 && S_ISCHR(st.st_mode) &&
+          (int64_t)major(st.st_rdev) == device_major &&
+          (int64_t)minor(st.st_rdev) == device_minor;
+}
+
+#endif
