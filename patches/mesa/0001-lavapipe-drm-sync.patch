+#ifdef HAVE_LIBDRM
+static VkResult
+lvp_init_drm_sync(struct lvp_physical_device *device)
+{
+   device->sync_drm_fd = -1;
+   const char *path = os_get_option("LVP_DRM_SYNC");
+   if (!path || !path[0])
+      return VK_SUCCESS;
+
+   int fd = open(path, O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return vk_errorf(device, VK_ERROR_INITIALIZATION_FAILED,
+                       "Cannot open LVP_DRM_SYNC device %s", path);
+
+   struct util_sync_provider *provider = util_sync_provider_drm(fd);
+   if (!provider) {
+      close(fd);
+      return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
+   }
+   device->drm_sync_type = vk_drm_syncobj_get_type_from_provider(provider);
+   provider->finalize(provider);
+   enum vk_sync_features required = VK_SYNC_FEATURE_CPU_WAIT |
+                                    VK_SYNC_FEATURE_CPU_SIGNAL |
+                                    VK_SYNC_FEATURE_TIMELINE;
+   if ((device->drm_sync_type.features & required) != required) {
+      close(fd);
+      return vk_errorf(device, VK_ERROR_INITIALIZATION_FAILED,
+                       "LVP_DRM_SYNC device lacks CPU timeline synchronization");
+   }
+
+   device->sync_drm_fd = fd;
+   /* The runtime permits only one timeline type per physical device. */
+   device->sync_types[1] = &device->drm_sync_type;
+   return VK_SUCCESS;
+}
+#endif
