[Unit]
Description=Pico DSP service map registry
DefaultDependencies=no
ConditionKernelCommandLine=reframed.pico=qrtr
ConditionPathExists=/etc/initrd-release
ConditionPathExists=/etc/reframed-vr/pico-service-maps.sha256
BindsTo=reframed-pico-qrtr.service
After=reframed-pico-qrtr.service
Before=initrd.target initrd-switch-root.target
Conflicts=initrd-switch-root.target
FailureAction=poweroff

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/libexec/reframed-pico-pd-mapper
TimeoutStartSec=12
TimeoutStopSec=5
KillMode=control-group
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=initrd.target
