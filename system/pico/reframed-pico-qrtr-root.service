[Unit]
Description=Pico QRTR name service
ConditionKernelCommandLine=reframed.pico=qrtr
ConditionPathExists=!/etc/initrd-release
After=local-fs.target
FailureAction=poweroff

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/libexec/reframed-pico-qrtr
TimeoutStartSec=12
TimeoutStopSec=5
KillMode=control-group
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
