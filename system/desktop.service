[Unit]
Description=Reframed VR interactive virtual desktop
After=systemd-user-sessions.service
ConditionKernelCommandLine=reframed.desktop=1

[Service]
ExecStart=/usr/local/libexec/reframed-vr/start-desktop.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
