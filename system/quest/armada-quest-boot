#!/bin/bash
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
mapper=
stage=identity

fail() {
    echo "Armada Quest startup failed: $stage: $*" >&2
    exit 1
}

cleanup() {
    if [[ -n $mapper ]]; then
        kill "$mapper" 2>/dev/null || :
        wait "$mapper" 2>/dev/null || :
    fi
}
trap cleanup EXIT
trap 'exit 0' TERM INT HUP

compatible() {
    local item
    [[ -r $1 ]] || return 1
    while IFS= read -r -d '' item; do
        [[ $item != "$2" ]] || return 0
    done < "$1"
    return 1
}

wait_for() {
    local deadline=$((SECONDS + 12))
    until "$@"; do
        [[ -z $mapper ]] || kill -0 "$mapper" 2>/dev/null || fail 'service mapper exited'
        ((SECONDS < deadline)) || fail 'timed out'
        sleep 0.1
    done
}

find_adsp() {
    local path found=
    for path in /sys/class/remoteproc/remoteproc*; do
        [[ -r $path/firmware ]] || continue
        [[ $(< "$path/firmware") == adsp.mdt ]] || continue
        compatible "$path/device/of_node/compatible" qcom,anorak-adsp-pas || continue
        [[ -z $found ]] || fail 'multiple matching ADSP devices'
        found=$path
    done
    [[ -n $found && -w /sys/kernel/boot_adsp/boot ]] || return 1
    adsp=$found
}

mapper_ready() {
    local service version instance rest
    while read -r service version instance rest; do
        [[ $service != 64 || $version != 1 || $instance != 1 ]] || return 0
    done < <(qrtr-lookup 64)
    return 1
}

usb_ready() {
    local path channel= port= host=
    [[ $(< "$adsp/state") == running ]] || return 1
    for path in /sys/bus/rpmsg/devices/*; do
        [[ -r $path/name && -L $path/driver ]] || continue
        [[ $(< "$path/name") == PMIC_RTR_ADSP_APPS ]] || continue
        [[ $(basename "$(readlink -f "$path/driver")") == pmic_glink_rpmsg ]] && channel=yes
    done
    for path in /sys/class/typec/port*; do
        compatible "$path/device/of_node/compatible" qcom,ucsi-glink || continue
        [[ -L $path/device/driver ]] || continue
        [[ $(basename "$(readlink -f "$path/device/driver")") == ucsi_glink ]] && port=yes
    done
    for path in /sys/class/usb_role/*; do
        compatible "$path/device/of_node/compatible" snps,dwc3 || continue
        [[ -r $path/role && $(< "$path/role") == host ]] && host=yes
    done
    [[ $channel == yes && $port == yes && $host == yes ]]
}

[[ $EUID == 0 ]] || fail 'requires root'
compatible /sys/firmware/devicetree/base/compatible oculus,eureka || fail 'requires Quest Eureka device tree'
compatible /sys/firmware/devicetree/base/compatible qcom,anorak || fail 'requires Anorak platform'
stage=firmware
sha256sum --strict -c /etc/armada-vr/quest-firmware.sha256 || fail 'firmware checksum mismatch'
stage=modules
for module in qrtr qrtr_smd qcom_q6v5_pas adsp_loader_dlkm pmic_glink ucsi_glink; do
    modprobe "$module" || fail "cannot load $module"
done
stage=adsp-device
wait_for find_adsp
stage=mapper
/usr/bin/pd-mapper &
mapper=$!
wait_for mapper_ready
stage=adsp-boot
case $(< "$adsp/state") in
    running) ;;
    offline)
        mkdir /run/armada-quest-adsp-requested || fail 'ADSP boot was already requested'
        printf '1\n' > /sys/kernel/boot_adsp/boot || fail 'ADSP boot request failed'
        ;;
    *) fail "unexpected ADSP state: $(< "$adsp/state")" ;;
esac
stage=usb-role
wait_for usb_ready
echo 'Armada Quest startup ready: ADSP running, PMIC channel, UCSI port and USB host role present'
systemd-notify --ready --status='Quest USB root prerequisites available'
stage=mapper-runtime
wait "$mapper" || fail 'service mapper exited'
fail 'service mapper stopped'
